      "item": [
        {
          "name": "Create Admin Test Project",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var now = new Date();",
                  "var start = new Date(now.getTime() + 86400000);",
                  "var end = new Date(now.getTime() + 30 * 86400000);",
                  "pm.collectionVariables.set(\"project_test_suffix\", String(Date.now()));",
                  "pm.collectionVariables.set(\"project_start_date\", start.toISOString().slice(0, 10));",
                  "pm.collectionVariables.set(\"project_end_date\", end.toISOString().slice(0, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var res = pm.response.json();",
                  "var project = res.data || res;",
                  "pm.test(\"Tạo project admin và lưu ID\", function () {",
                  "    pm.expect(project).to.have.property(\"id\");",
                  "    pm.collectionVariables.set(\"project_admin_test_id\", String(project.id));",
                  "});"
