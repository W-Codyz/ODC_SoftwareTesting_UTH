    {
      "name": "1 - ProjectAdminController (LAB_ADMIN)",
      "item": [
        {
          "name": "Create Admin Test Project",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var now = new Date();",
                  "var start = new Date(now.getTime() + 86400000);",
                  "var end = new Date(now.getTime() + 30 * 86400000);",
                  "pm.collectionVariables.set(\"project_test_suffix\", String(Date.now()));",
                  "pm.collectionVariables.set(\"project_start_date\", start.toISOString().slice(0, 10));",
                  "pm.collectionVariables.set(\"project_end_date\", end.toISOString().slice(0, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var res = pm.response.json();",
                  "var project = res.data || res;",
                  "pm.test(\"Tạo project admin và lưu ID\", function () {",
                  "    pm.expect(project).to.have.property(\"id\");",
                  "    pm.collectionVariables.set(\"project_admin_test_id\", String(project.id));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"enterpriseId\": {{enterprise_id}},\n  \"title\": \"Postman Admin Test {{project_test_suffix}}\",\n  \"description\": \"Test project created by the ProjectAdmin Postman collection.\",\n  \"objectives\": \"[\\\"Verify ProjectAdmin endpoints\\\"]\",\n  \"requirements\": \"Postman API test data\",\n  \"startDate\": \"{{project_start_date}}\",\n  \"endDate\": \"{{project_end_date}}\",\n  \"budget\": 10000000,\n  \"currency\": \"VND\",\n  \"numberOfStudents\": 3,\n  \"status\": \"PENDING_VALIDATION\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/lab-admin/projects"
          },
          "response": []
        },
        {
          "name": "Get Admin Projects",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/lab-admin/projects?page=0&size=20"
