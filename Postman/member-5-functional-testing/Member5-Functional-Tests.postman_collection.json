            "body": {
              "mode": "raw",
              "raw": "{\n  \"reportType\": \"MONTHLY\",\n  \"reportingPeriod\": \"{{reporting_period}}\",\n  \"overallProgress\": 45,\n  \"tasksCompleted\": [],\n  \"tasksInProgress\": [],\n  \"issues\": [],\n  \"nextMonthPlan\": [],\n  \"teamPerformance\": {\n    \"collaboration\": 4.5,\n    \"communication\": 4.0,\n    \"productivity\": 4.2,\n    \"codeQuality\": 4.3\n  },\n  \"attachments\": []\n}",
              "options": {
