              }
            },
            "url": "{{base_url}}/api/talent-leader/projects/{{project_id}}/reports"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"SRS valid report is accepted (expected HTTP 201)\", function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) { var json = pm.response.json(); var data = json.data || {}; var id = data.reportId || data.id; if (id) pm.environment.set(\"report_id\", String(id)); }"
                ]
              }
            }
          ]
