  "item": [
    {
      "name": "00 - Authentication",
      "item": [
        {
          "name": "Login Mentor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{mentor_email}}\",\n  \"password\": \"{{mentor_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
            }
            },
            "url": "{{base_url}}/api/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login returns HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "var data = json.data || json;",
                  "var token = data.token || data.accessToken;",
                  "pm.test(\"Login response contains a token\", function () { pm.expect(token).to.be.a(\"string\").and.not.empty; });",
                  "if (token) pm.environment.set(\"mentor_token\", token);"
                ]
              }
            }
          ]
        },
