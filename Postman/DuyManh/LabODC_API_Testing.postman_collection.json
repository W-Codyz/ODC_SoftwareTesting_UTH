{
  "info": {
    "name": "DuyManh - Mentor Portal APIs",
    "description": "Mentor Portal requests for labodc-backend on localhost:8089. Before running invitation fixture cases, execute scripts/postman_mentor_invitations_fixtures.sql in pgAdmin; run cleanup_postman_mentor_invitations_fixtures.sql afterward. Seed login: mentor.nguyenquang@uth.edu.vn / 123123. MI-05 validates null/default mapping with an existing project; missing-project fallback cannot be represented while the FK is enabled. Mentor Projects suite added: MP-01?MP-16. Run scripts/postman_mentor_projects_fixtures.sql before MP-03/05; run cleanup_postman_mentor_projects_fixtures.sql afterward.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0 - Login MENTOR",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"mentor.nguyenquang@uth.edu.vn\",\n  \"password\": \"123123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{mentor_base_url}}/api/auth/login",
          "host": [
            "{{mentor_base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "description": "Login with seeded Mentor 1. Stores data.token in environment variable token."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login returns 200', function () { pm.response.to.have.status(200); });",
              "let body = {}; try { body = pm.response.json(); } catch (e) {}",
              "const token = body?.data?.token || body?.token;",
              "pm.test('Login response contains a token', function () { pm.expect(token).to.be.a('string').and.not.empty; });",
              "if (token) pm.environment.set('token', token);"
            ]
          }
        }
      ],
      "response": []
    },
