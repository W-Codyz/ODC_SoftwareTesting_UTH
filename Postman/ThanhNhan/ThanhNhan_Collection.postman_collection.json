        {
          "name": "Login ENTERPRISE",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();\nif (res.data && res.data.token) { pm.environment.set(\"token\", res.data.token); }\npm.test(\"Login success\", function () { pm.response.to.have.status(200); });\npm.test(\"Token saved\", function () { pm.expect(pm.environment.get(\"token\")).to.not.be.empty; });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"contact@techcorp.vn\",\"password\":\"123123\"}",
              "options": {
